diff --git a/src/App.css b/src/App.css
index 7107b7c..39f1c55 100644
--- a/src/App.css
+++ b/src/App.css
@@ -1,2831 +1 @@
-@import url('https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap');
-
-*,
-*::before,
-*::after {
-  box-sizing: border-box;
-  margin: 0;
-  padding: 0;
-}
-
-:root {
-  --bg-void: #050608;
-  --bg-deep: #0a0d12;
-  --bg-surface: rgba(18, 22, 30, 0.92);
-  --bg-raised: rgba(24, 30, 40, 0.96);
-  --bg-hover: rgba(30, 38, 52, 0.96);
-  --bg-active: rgba(36, 46, 62, 0.98);
-
-  --accent: #8bf27d;
-  --accent-dim: #5be06b;
-  --accent-glow: rgba(139, 242, 125, 0.14);
-  --accent-border: rgba(139, 242, 125, 0.34);
-
-  --border: rgba(255, 255, 255, 0.08);
-  --border-mid: rgba(255, 255, 255, 0.13);
-  --border-bright: rgba(255, 255, 255, 0.22);
-
-  --text-primary: #f3f7fb;
-  --text-secondary: #c0cad7;
-  --text-muted: #7e8898;
-
-  --danger: #ff6b74;
-  --warning: #f0b85c;
-  --info: #73b7ff;
-
-  --radius-sm: 10px;
-  --radius-md: 14px;
-  --radius-lg: 20px;
-
-  --font-display: 'Inter Tight', sans-serif;
-  --font-mono: 'JetBrains Mono', monospace;
-  --font-body: 'Inter', sans-serif;
-
-  --titlebar-height: 42px;
-  --page-gutter: clamp(16px, 1.6vw, 40px);
-}
-
-html,
-body,
-#root {
-  width: 100%;
-  height: 100%;
-  overflow: hidden;
-  background:
-    radial-gradient(circle at top left, rgba(139, 242, 125, 0.10), transparent 32%),
-    radial-gradient(circle at top right, rgba(115, 183, 255, 0.08), transparent 28%),
-    linear-gradient(180deg, #070a0f 0%, #090c12 45%, #050608 100%);
-  color: var(--text-primary);
-  font-family: var(--font-body);
-  -webkit-font-smoothing: antialiased;
-  text-rendering: geometricPrecision;
-  user-select: none;
-}
-
-body {
-  position: relative;
-}
-
-body::before {
-  content: '';
-  position: fixed;
-  inset: 0;
-  pointer-events: none;
-  background-image:
-    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
-    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
-  background-size: 36px 36px;
-  mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.42), transparent 85%);
-  opacity: 0.6;
-}
-
-/* ── TITLEBAR ── */
-.titlebar {
-  height: var(--titlebar-height);
-  background: rgba(7, 9, 13, 0.78);
-  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
-  display: flex;
-  align-items: center;
-  justify-content: space-between;
-  padding: 0 12px 0 16px;
-  -webkit-app-region: drag;
-  position: relative;
-  z-index: 100;
-  flex-shrink: 0;
-  backdrop-filter: blur(18px);
-  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03) inset;
-}
-
-.titlebar-brand {
-  display: flex;
-  align-items: center;
-  gap: 8px;
-  -webkit-app-region: no-drag;
-}
-
-.titlebar-logo {
-  width: 18px;
-  height: 18px;
-  border-radius: 6px;
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  box-shadow: 0 0 0 4px rgba(139, 242, 125, 0.06);
-}
-
-.titlebar-logo-inner {
-  width: 6px;
-  height: 6px;
-  background: var(--accent);
-  border-radius: 1px;
-}
-
-.titlebar-name {
-  font-family: var(--font-display);
-  font-size: 14px;
-  font-weight: 800;
-  letter-spacing: 0.04em;
-  color: var(--text-primary);
-  text-transform: none;
-}
-
-.titlebar-version {
-  font-family: var(--font-mono);
-  font-size: 10px;
-  color: var(--text-secondary);
-  padding: 3px 8px;
-  border-radius: 999px;
-}
-
-.titlebar-controls {
-  display: flex;
-  gap: 4px;
-  -webkit-app-region: no-drag;
-}
-
-.win-btn {
-  width: 34px;
-  height: 28px;
-  border: none;
-  background: transparent;
-  color: var(--text-muted);
-  cursor: pointer;
-  border-radius: 999px;
-  display: flex;
-  align-items: center;
-  justify-content: center;
-  font-size: 11px;
-  transition: background 0.15s, color 0.15s;
-}
-
-.win-btn:hover {
-  background: rgba(255, 255, 255, 0.07);
-  color: var(--text-primary);
-}
-
-.win-btn.close:hover {
-  background: var(--danger);
-  color: #fff;
-}
-
-/* ── LAYOUT ── */
-.app-layout {
-  width: 100%;
-  height: calc(100vh - var(--titlebar-height));
-  display: grid;
-  grid-template-columns: minmax(350px, 24vw) minmax(0, 1fr);
-  grid-template-rows: 1fr;
-  overflow: hidden;
-  gap: 0;
-}
-
-/* ── SIDEBAR ── */
-.sidebar {
-  background: rgba(10, 13, 18, 0.80);
-  border-right: 1px solid rgba(255, 255, 255, 0.06);
-  display: flex;
-  flex-direction: column;
-  overflow: hidden;
-  backdrop-filter: blur(16px);
-}
-
-.sidebar-section {
-  padding: 16px 14px 10px;
-}
-
-.sidebar-label {
-  font-family: var(--font-mono);
-  font-size: 10px;
-  letter-spacing: 0.18em;
-  color: var(--text-muted);
-  text-transform: uppercase;
-  margin-bottom: 8px;
-  padding: 0 4px;
-}
-
-/* Profile selector */
-.profile-card {
-  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
-  border: 1px solid var(--border);
-  border-radius: var(--radius-md);
-  padding: 12px 13px;
-  cursor: pointer;
-  transition: border-color 0.2s, background 0.2s, transform 0.2s, box-shadow 0.2s;
-  position: relative;
-  overflow: hidden;
-  margin-bottom: 6px;
-}
-
-.profile-card::before {
-  content: '';
-  position: absolute;
-  left: 0;
-  top: 0;
-  bottom: 0;
-  width: 2px;
-  background: var(--accent);
-  border-radius: 0 2px 2px 0;
-  opacity: 0;
-  transition: opacity 0.2s;
-}
-
-.profile-card.active::before {
-  opacity: 1;
-}
-
-.profile-card.active {
-  border-color: var(--accent-border);
-  background: rgba(139, 242, 125, 0.08);
-  box-shadow: 0 14px 30px rgba(0, 0, 0, 0.20);
-}
-
-.profile-card:hover:not(.active) {
-  border-color: var(--border-bright);
-  background: var(--bg-hover);
-  transform: translateY(-1px);
-}
-
-.profile-card-header {
-  display: flex;
-  align-items: center;
-  justify-content: space-between;
-  margin-bottom: 4px;
-}
-
-.profile-card-actions {
-  display: flex;
-  align-items: center;
-  gap: 6px;
-}
-
-.profile-name {
-  font-family: var(--font-display);
-  font-size: 15px;
-  font-weight: 700;
-  color: var(--text-primary);
-  letter-spacing: 0.01em;
-}
-
-.profile-badge {
-  font-family: var(--font-mono);
-  font-size: 9px;
-  color: var(--accent);
-  background: var(--accent-glow);
-  border: 1px solid var(--accent-border);
-  padding: 2px 6px;
-  border-radius: 999px;
-  text-transform: uppercase;
-  letter-spacing: 0.08em;
-}
-
-.profile-edit-btn {
-  width: 24px;
-  height: 24px;
-  border-radius: 8px;
-  border: 1px solid var(--border);
-  background: rgba(255, 255, 255, 0.02);
-  color: var(--text-muted);
-  display: inline-flex;
-  align-items: center;
-  justify-content: center;
-  cursor: pointer;
-  transition: background 0.16s, border-color 0.16s, color 0.16s, transform 0.16s;
-}
-
-.profile-edit-btn:disabled {
-  cursor: not-allowed;
-  opacity: 0.5;
-}
-
-.profile-edit-btn:hover:not(:disabled) {
-  background: rgba(255, 255, 255, 0.08);
-  border-color: var(--accent-border);
-  color: var(--text-primary);
-  transform: translateY(-1px);
-}
-
-.profile-delete-btn {
-  width: 24px;
