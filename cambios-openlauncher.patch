+    const entitlement = await json('https://api.minecraftservices.com/entitlements/mcstore', options);
+    if (!entitlement.items?.length) throw new Error('La cuenta no tiene un derecho de acceso válido a Minecraft Java.');
+    const profile = await json('https://api.minecraftservices.com/minecraft/profile', options);
+    if (!/^[a-f0-9]{32}$/i.test(profile.id) || !profile.name) throw new Error('No hay un perfil de Minecraft Java disponible.');
+    return { mode: 'microsoft', name: profile.name, uuid: profile.id, accessToken: mc.access_token, xuid: claim.xid || '', userType: 'msa' };
+  }
+}
