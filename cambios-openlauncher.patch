+const invoke = async (method, value) => {
+  const result = await ipcRenderer.invoke(`gluplandia:${method}`, value);
+  if (!result.ok) throw new Error(result.error);
+  return result.data;
+};
+contextBridge.exposeInMainWorld('gluplandia', {
+  initial: () => invoke('initial'), content: () => invoke('content'), status: () => invoke('status'),
+  offline: name => invoke('offline', name), microsoft: () => invoke('microsoft'), logout: () => invoke('logout'),
+  play: () => invoke('play'), repair: () => invoke('repair'), cancel: () => invoke('cancel'),
+  preferences: data => invoke('preferences', data), folder: area => invoke('folder', area),
+  website: () => invoke('website'), update: () => invoke('update'), restart: () => invoke('restart'),
+  onEvent(callback) { const listener = (_event, value) => callback(value); ipcRenderer.on('gluplandia:event', listener); return () => ipcRenderer.removeListener('gluplandia:event', listener); }
+});
